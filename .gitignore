.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
build/
dist/
# data artifacts — never commit bulk NetCDF/parquet (fixtures under tests/ are the exception).
# data/* excludes bulk bronze/calib but leaves the two small, deterministic accumulation
# logs tracked: they ARE the standing accuracy record the daily Action appends to.
data/*
!data/gate_log.csv
!data/forecast_gate_log.csv
!data/nearshore_anchor.csv
!data/offshore_check_log.csv
!data/wind_gate_log.csv
!data/field_sessions.csv
# the upwelling-favorability calibration record IS committed — small, auditable provenance
# (fitted params, or a logged null result) that the build reads to decide prior-vs-fitted.
!data/calib/
!data/calib/upwelling_favorability.json
!data/calib/bathy_slope.json
!data/calib/forecast_lead_error.json
!data/calib/wind_model_eval.json
!data/calib/flow_climatology.json
!data/hindcast_request.json
# frozen water masks ARE committed: the static shoreline must be deterministic across
# builds, not re-fetched live from Overpass every run (CLAUDE.md rule #1).
!data/watermask_frozen/
!data/watermask_frozen/**
*.parquet
*.nc
!tests/fixtures/*.nc
.DS_Store
scratch/
.cdsapirc

# Forum credentials (ADR-042 forum access). NEVER committed — supplied via env vars or this
# gitignored file, read at runtime only.
.forum_creds
knowledge/observations/candidates/*.tmp

# ADR-049: the thermal gate's paired-sample log and its skill analysis ARE the standing accuracy
# record — a season of hindcast (6,291 rows) that answers the ADR-006 demotion question. Committed
# for the same reason as gate_log.csv: the evidence behind a published verdict has to be auditable.
!data/thermal_gate_log.csv
!data/calib/thermal_skill.json
# ADR-051: the Thunder Bay SURFACE gate — the first validation this project has ever had at the
# place it actually forecasts for. Committed for the same reason as the others: a published
# verdict has to carry its evidence.
!data/surface_gate_log.csv
!data/calib/surface_skill.json

# ADR-045: FROZEN river geometry is a committed ARTIFACT, not a cache. It holds the lidar-derived
# centreline, water surface, width and bends so the daily seam build needs no lidar range reads and
# no Overpass call (3.4 s instead of minutes, and no dependency on a rate-limited public API).
# Same reasoning as data/watermask_frozen/, which is likewise committed under this data/* rule.
!data/river_geometry.json

# Station-file extracts are a CACHE (the .nc is fetched, read and discarded); regenerable.
data/lsofs_station_cache/
data/wind_archive_cache/
data/eccc_wind_cache/
data/prev_runs_cache/
